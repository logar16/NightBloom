{
  "name": "astroimp-studio",
  "private": true,
  "license": "MIT",
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "dev:desktop": "vite --host 127.0.0.1 --strictPort --mode desktop",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "e2e": "playwright test",
    "gen:api": "node src/api/generate.mjs",
    "tauri": "cd ..\\src-tauri && tauri",
    "desktop:check": "cargo check --manifest-path ..\\src-tauri\\Cargo.toml --features desktop --bin astroimp-desktop",
    "desktop:build": "npm run build && cargo build --manifest-path ..\\src-tauri\\Cargo.toml --release --features desktop --bin astroimp-desktop",
    "desktop:dev": "cd ..\\src-tauri && tauri dev --features desktop -- --bin astroimp-desktop -- --dev",
    "desktop:run": "npm run build && cargo run --manifest-path ..\\src-tauri\\Cargo.toml --features desktop --bin astroimp-desktop --",
    "desktop:bundle": "npm run build && cd ..\\src-tauri && tauri build --features desktop -- --bin astroimp-desktop"
  },
  "dependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "lucide-react": "^1.58.0",
    "zustand": "^5.0.15",
    "@tanstack/react-query": "^5.104.3",
    "openapi-fetch": "^0.17.0"
  },
  "devDependencies": {
    "typescript": "^5.9.3",
    "vite": "^8.3.4",
    "@vitejs/plugin-react": "^6.1.2",
    "openapi-typescript": "^7.13.0",
    "vitest": "^4.1.12",
    "@playwright/test": "^1.64.1",
    "@tauri-apps/cli": "^2.12.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/node": "^26.6.5"
  }
}
